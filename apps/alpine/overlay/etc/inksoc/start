#!/bin/sh
# InkSoC: start of the Alpine terminal. The first start creates your user (like WSL).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
if [ ! -s /etc/inksoc/user ]; then
  printf '\033[1mWelcome to Alpine Linux on InkSoC.\033[0m\n'
  echo "First start: create your Linux user. It does not need to match any other account."
  while :; do
    printf "New UNIX username: "; read -r u || exit 0
    if echo "$u" | grep -qE '^[a-z_][a-z0-9_-]{0,31}$' && [ "$u" != root ]; then break; fi
    echo "Use lowercase letters, digits, - or _ (and not root)."
  done
  while :; do
    stty -echo
    printf "New password: "; read -r p; echo
    printf "Retype new password: "; read -r p2; echo
    stty echo
    if [ -n "$p" ] && [ "$p" = "$p2" ]; then break; fi
    echo "The passwords are empty or do not match. Try again."
  done
  adduser -D -s /bin/sh "$u" >/dev/null 2>&1
  addgroup "$u" wheel >/dev/null 2>&1
  echo "$u:$p" | chpasswd >/dev/null 2>&1
  echo "root:$p" | chpasswd >/dev/null 2>&1
  unset p p2
  echo "$u" > /etc/inksoc/user
  echo "Done. The same password works for sudo and for su (root)."
  echo
fi
u=$(cat /etc/inksoc/user)
cat /etc/motd
exec su -l "$u"
