#!/bin/sh
b=$(printf '\033[1m'); n=$(printf '\033[0m')
cat <<T
${b}Alpine Linux on InkSoC${n}
This is the real Alpine Linux 3.21 (x86-64). Our engine plays the part of the
Linux kernel, like WSL 1 does on Windows. Your files are kept in this browser.

${b}Packages (apk)${n}
  sudo apk update                 refresh the package lists
  sudo apk add python3 git        install programs (search: apk search NAME)
  sudo apk del NAME               remove one
  apk info                        what is installed
  Repositories: /etc/apk/repositories (main and community are on). To add
  edge/testing:  echo https://dl-cdn.alpinelinux.org/alpine/edge/testing | sudo tee -a /etc/apk/repositories

${b}Network${n}
  Goes out through a public wisp server (button at the top: wisp or off).
  wget, curl, git, apk, ssh to other machines work. Servers inside this
  terminal cannot be reached from outside.

${b}SSH${n}
  sudo apk add openssh-client
  ssh user@example.com

${b}Users${n}
  sudo CMD        run one command as root (your password)
  su              become root;  exit  to come back
  passwd          change your password

${b}Files${n}
  The ⇡ button sends files from this device to your home folder; ⇣ downloads one.
  ☰ > Reset Linux starts again from a clean Alpine.

${b}Speed${n}
  bench           CPU, memory, compression and file test, with times

${b}Not yet${n}
  Programs with several threads, servers that listen on a port, graphical apps.
T
