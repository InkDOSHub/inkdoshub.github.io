<Project Sdk="Microsoft.NET.Sdk">
  <!-- InkDOS Hub para Windows: lançador nativo (WinForms, .NET Framework 4.8, que já vem no Windows 10 e 11).
       Um .exe pequeno, sem motor web; as ferramentas pesadas são programas nativos baixados só se a pessoa quiser. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>InkDOS Hub</AssemblyName>
    <RootNamespace>InkDOSHub</RootNamespace>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>InkDOS Hub</Product>
    <Copyright>MIT</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="..\ferramentas.json" LogicalName="ferramentas.json" />
    <EmbeddedResource Include="icones\*.png" LogicalName="icones/%(Filename).png" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
