#!/bin/sh
# inksessao: saves and restores this Linux's "recipe" for the page's Session button.
# The page writes /mnt/ipad/.inkdoshub/pedido ("salvar" = save or "restaurar" = restore) and reads "estado".
# "estado" starts with a code the page checks (trabalhando, ok, aviso, erro) followed by free text.
#   salvar:    receita.tar.gz with the package list (etc/apk/world), the repositories,
#              /root (without ~/files or caches), /home and /usr/local
#   restaurar: installs the listed packages (apk add, needs internet) and puts the files back
D=/mnt/ipad/.inkdoshub
ITENS="etc/apk/world etc/apk/repositories root home usr/local"

estado() { echo "$*" > "$D/estado.tmp" && mv -f "$D/estado.tmp" "$D/estado"; }

salvar() {
  estado "trabalhando gathering the files"
  rm -f "$D/receita.tmp" "$D/receita.tar.gz"
  L=""
  for i in $ITENS; do [ -e "/$i" ] && L="$L $i"; done
  # shellcheck disable=SC2086
  if (cd / && tar -czf "$D/receita.tmp" --exclude=root/ipad --exclude=root/files --exclude=root/.cache --exclude=usr/local/sbin/inksessao $L) 2>"$D/erro.log" \
     && mv -f "$D/receita.tmp" "$D/receita.tar.gz"; then
    estado "ok $(wc -c < "$D/receita.tar.gz") $(grep -c . /etc/apk/world)"
  else
    rm -f "$D/receita.tmp"
    estado "erro $(tail -n 1 "$D/erro.log")"
  fi
}

restaurar() {
  T=/tmp/inksessao
  rm -rf "$T" && mkdir -p "$T"
  estado "trabalhando opening the file"
  if ! tar -xzf "$D/receita.tar.gz" -C "$T" 2>"$D/erro.log"; then
    estado "erro $(tail -n 1 "$D/erro.log")"; rm -rf "$T"; return
  fi
  rm -f "$D/receita.tar.gz"
  [ -f "$T/etc/apk/repositories" ] && cp -f "$T/etc/apk/repositories" /etc/apk/repositories
  FALTAM=""
  if [ -f "$T/etc/apk/world" ]; then
    # só nomes de pacote (nada que comece com "-", que o apk leria como opção)
    for p in $(grep -E '^[A-Za-z0-9][A-Za-z0-9._+=<>~@-]*$' "$T/etc/apk/world"); do grep -qx "$p" /etc/apk/world || FALTAM="$FALTAM $p"; done
  fi
  APK=ok
  if [ -n "$FALTAM" ]; then
    N=$(echo $FALTAM | wc -w)
    [ "$N" = 1 ] && W=package || W=packages
    estado "trabalhando installing $N $W from the internet"
    # shellcheck disable=SC2086
    if ! { apk update && apk add $FALTAM; } >"$D/apk.log" 2>&1; then
      APK=falhou
      echo $FALTAM > /root/session-packages.txt
    fi
  fi
  estado "trabalhando putting the files back"
  for i in root home usr/local; do
    [ -d "$T/$i" ] && mkdir -p "/$i" && cp -a "$T/$i/." "/$i/"
  done
  ln -sfn /mnt/ipad /root/files
  rm -rf "$T"
  if [ "$APK" = ok ]; then estado "ok restored"; else estado "aviso $(tail -n 1 "$D/apk.log")"; fi
}

mkdir -p "$D"
while :; do
  if [ -f "$D/pedido" ]; then
    P=$(cat "$D/pedido"); rm -f "$D/pedido"
    case "$P" in
      salvar) salvar ;;
      restaurar) restaurar ;;
    esac
  fi
  sleep 2
done
